from __future__ import annotations

from collections.abc import Callable
from typing import Any, Generic, TypeVar

T = TypeVar("T")


class Vector:
    """Fixed-dimension vector annotation metadata."""
    dimensions: int
    def __init__(self, dimensions: int) -> None: ...


class Field(Generic[T]):
    """Typed semantic field expression."""
    name: str
    def is_null(self) -> dict[str, Any]: ...
    def is_not_null(self) -> dict[str, Any]: ...
    def starts_with(self, value: str) -> dict[str, Any]: ...
    def contains(self, value: str) -> dict[str, Any]: ...


class Spec:
    """Canonical semantic ontology document."""
    models: dict[type, str]
    def __init__(self, *, data: dict[str, Any] | None = ...) -> None: ...
    def add(self, section: str, item: dict[str, Any]) -> None: ...
    def object_type(self, *, primary_key: str, name: str | None = ..., **fields: Any) -> Callable[[type[T]], type[T]]: ...
    def action(self, *, subject: type | str | None = ..., name: str | None = ..., **fields: Any) -> Callable[[type[T]], type[T]]: ...
    def link(self, *, from_type: type | str, to_type: type | str, cardinality: str = ..., name: str | None = ..., **fields: Any) -> Callable[[type[T]], type[T]]: ...
    def to_dict(self) -> dict[str, Any]: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> Spec: ...
    @classmethod
    def from_json(cls, data: str) -> Spec: ...
