from __future__ import annotations

from collections.abc import Mapping
from typing import Any, Generic, TypeVar

from .model import Spec

T = TypeVar("T")


class QuerySet(Generic[T]):
    """Lazy typed query assembled before one native call."""
    def where(self, predicate: dict[str, Any]) -> QuerySet[T]: ...
    def take(self, limit: int) -> QuerySet[T]: ...
    def load(self) -> list[T]: ...


class Runtime:
    """Typed runtime over direct native values."""
    def __init__(self, spec: Spec, *, objects: Mapping[type | str, object], policy: object, links: Mapping[str, object] | None = ..., actions: Mapping[type | str, object] | None = ..., max_query_limit: int = ...) -> None: ...
    def objects(self, model: type[T], *, context: dict[str, Any] | None = ...) -> QuerySet[T]: ...
    def search(self, model: type[T], query: dict[str, Any] | None = ..., *, context: dict[str, Any] | None = ...) -> dict[str, Any]: ...
    def get(self, model: type[T], key: Any, *, context: dict[str, Any] | None = ...) -> T: ...
    def mutate(self, model: type | str, mutation: dict[str, Any], *, context: dict[str, Any] | None = ...) -> dict[str, Any]: ...
    def aggregate(self, model: type | str, query: dict[str, Any] | None = ..., *, context: dict[str, Any] | None = ...) -> dict[str, Any]: ...
    def traverse(self, link: str, query: dict[str, Any], *, context: dict[str, Any] | None = ...) -> dict[str, Any]: ...
    def execute_action(self, action: type | str, input: dict[str, Any], *, context: dict[str, Any] | None = ..., expected_revision: str | None = ...) -> dict[str, Any]: ...
    def capabilities(self, task: str, *, context: dict[str, Any] | None = ...) -> dict[str, Any]: ...
